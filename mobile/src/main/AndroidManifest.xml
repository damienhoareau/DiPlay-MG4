<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:sharedUserId="android.uid.system">

    <!-- Declared by the stock CarPlay app (SWI133, versionCode 104); other system apps may still request it. -->
    <permission
        android:name="com.allgo.carplaysurfacebinderservice.permissions.CALL_CARPLAYSET"
        android:permissionGroup="android.permission-group.HARDWARE_CONTROLS"
        android:protectionLevel="dangerous" />

    <!-- MG4 platform-signed build: lets MG4CPlay claim the iPhone before the stock AllGo host. -->
    <uses-permission android:name="android.permission.MANAGE_USB" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.TETHER_PRIVILEGED" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.INTERNAL_SYSTEM_WINDOW" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.GET_TASKS" />

    <application
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@drawable/ic_carplay"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@drawable/ic_carplay"
        android:supportsRtl="true"
        android:theme="@style/Theme.Xcertplay">

        <receiver
            android:name="com.shilapi.xcertplay.BootReceiver"
            android:enabled="true"
            tools:replace="android:enabled" />

        <service
            android:name="com.shilapi.xcertplay.Mg4LauncherOverlayService"
            android:exported="false" />

        <!-- Identity of the stock CarPlay app this package replaces: the launcher's CarPlay tile
             starts this component by name (com.allgo.carplay.service/.CarPlayActivity); same MAIN filter as stock. -->
        <activity-alias
            android:name="com.allgo.carplay.service.CarPlayActivity"
            android:exported="true"
            android:targetActivity="com.shilapi.xcertplay.DiPlayActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
            </intent-filter>
        </activity-alias>

        <service android:name="com.shilapi.xcertplay.shared.MyCarAppService" tools:node="remove" />
        <meta-data android:name="androidx.car.app.minCarApiLevel" tools:node="remove" />
    </application>

</manifest>
